# podpischiki.json — запасное хранилище подписчиков, когда нет базы.
# Внутри telegram-id живых людей. В публичном репозитории им не место
# ни на минуту: git помнит всё, и удалить это потом уже не получится.
bot/podpischiki.json
bot/podpischiki.json.tmp

# Ручные замеры Видадия. Не секрет, но и не код: файл живёт рядом с ботом
# и правится вручную, а его версия в репозитории будет вечно расходиться
# с той, что на хостинге.
bot/rates_manual.json

# ── Кеши и мусор сборки ──────────────────────────────────────────────
