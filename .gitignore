# Кеш истории курсов: пересобирается сам раз в сутки.
bot/istoriya_kesh.json
bot/istoriya_kesh.json.tmp

# Скомпилированный Python. Раньше лежал в репозитории и попадал в каждый
# коммит шумом, из-за которого не видно настоящих правок.
__pycache__/
*.py[cod]

# jsdom для проверок ставится отдельно и в проект не входит: у приложения
# зависимостей нет и не будет — оно должно остаться статическими файлами.
node_modules/
package-lock.json
package.json

# Виртуальное окружение Python. Нужно только инструментам сборки: Pillow для
# обложки, sqlglot для проверки SQL. У самого бота зависимость одна
# (psycopg2-binary), и её ставит Render по requirements.txt.
.venv/

